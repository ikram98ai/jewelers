# Copy to .env.local for local development (`pnpm db:start` prints these values).
# Only the PUBLIC anon/publishable key belongs here. Never put the service-role key in the app.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Synthetic email domain used to turn usernames into Supabase logins. Must match
# LOGIN_EMAIL_DOMAIN in the admin-users function.
VITE_LOGIN_EMAIL_DOMAIN=shop.local
